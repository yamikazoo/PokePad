DB_USERNAME=
DB_PASSWORD=

# Amazon S3 catalog image cache
# Create an IAM user (not root) with PutObject/GetObject/DeleteObject/ListBucket
# on arn:aws:s3:::YOUR_BUCKET and arn:aws:s3:::YOUR_BUCKET/*
# Create a bucket, then add a bucket policy that allows public s3:GetObject
# only on arn:aws:s3:::YOUR_BUCKET/catalog/*
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=pokepad-bucket
AWS_S3_ENABLED=true
